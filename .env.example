APP_NAME=Goravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=sqlite
DB_DATABASE=
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Save GitHub events
APP_HOST=0.0.0.0
APP_PORT=4500
GITHUB_WEBHOOK_SECRET=

# Consume GitHub events
AGENT_BASE_URL=http://localhost:4500/webhooks/events
AGENT_PROJECT_NAME=agent
AGENT_ALLOWED_SENDERS=
AGENT_MENTION=@goravel-agent
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Notification in Discord
DISCORD_BOT_TOKEN=
DISCORD_PULL_REQUESTS_CHANNEL_ID=
DISCORD_CORE_ROLE_ID=
DISCORD_HEARTBEAT_CHANNEL_ID=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
MAIL_TO=

# used by Save GitHub events, Consume GitHub events
AGENT_API_TOKEN=

# used by Consume GitHub events, Release Goravel version
GITHUB_TOKEN=
