APP_NAME=Goravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

AI_PROVIDER=deepseek

# Required when AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# OpenAI-compatible endpoint
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Text model used for routing and agent runs. Supported: deepseek-flash, deepseek-v4-pro.
DEEPSEEK_MODEL=deepseek-flash

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

AGENT_BASE_URL=http://localhost:4500/webhooks/events
AGENT_API_TOKEN=
# Paseo project every run workspace is created in; blank stops `poll-events`.
AGENT_PROJECT_NAME=agent
# Required, e.g. AGENT_ALLOWED_SENDERS=bowen
AGENT_ALLOWED_SENDERS=
# Handle that triggers an agent run; blank uses the built-in `@goravel-agent`.
AGENT_MENTION=@goravel-agent

# Release commands: Contents, Pull requests and Actions read/write.
# Reaction reactor: `issues: write`, `pull-requests: write` (or classic `repo`);
# blank disables reactions and the poller still dispatches runs.
GITHUB_TOKEN=

DISCORD_BOT_TOKEN=
DISCORD_HEARTBEAT_CHANNEL_ID=
DISCORD_PULL_REQUESTS_CHANNEL_ID=
DISCORD_CORE_ROLE_ID=

GITHUB_WEBHOOK_SECRET=
API_TOKEN=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
MAIL_TO=

SESSION_DRIVER=file
SESSION_LIFETIME=120
